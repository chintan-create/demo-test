{
  "$schema": "https://schemas.wp.org/wp/6.7/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": true,
      "palette": [
        { "slug": "canvas", "color": "#FAF6EC", "name": "Warm Ivory Canvas" },
        { "slug": "surface", "color": "#F4EFE3", "name": "Sand Surface" },
        { "slug": "burgundy", "color": "#551020", "name": "Deep Burgundy" },
        { "slug": "amber", "color": "#DDA132", "name": "Golden Amber" },
        { "slug": "olive", "color": "#8A9332", "name": "Botanical Olive" },
        { "slug": "ink", "color": "#1C1513", "name": "Espresso Ink" },
        { "slug": "muted", "color": "#584D46", "name": "Muted Warm Slate" },
        { "slug": "border", "color": "#E2DACB", "name": "Hairline Border" },
        { "slug": "footer", "color": "#080808", "name": "Footer Obsidian" }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "'Playfair Display', Georgia, serif",
          "slug": "display",
          "name": "Playfair Display"
        },
        {
          "fontFamily": "'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif",
          "slug": "body",
          "name": "Plus Jakarta Sans"
        }
      ]
    },
    "layout": {
      "contentSize": "1080px",
      "wideSize": "1200px"
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--canvas)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)"
    }
  }
}
